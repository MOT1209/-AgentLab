{
  "name": "agentlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "tsc && node --test \"dist/test/*.test.js\"",
    "dev:api": "tsc && node dist/src/api/main.js",
    "skills:list": "tsc && node dist/src/skills/cli.js list",
    "skills:validate": "tsc && node dist/src/skills/cli.js validate",
    "skills:sync": "tsc && node dist/src/skills/cli.js sync",
    "explore": "tsc && node dist/examples/explore.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0"
  }
}
