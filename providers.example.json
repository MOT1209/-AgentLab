{
  "providers": [
    {
      "id": "claude",
      "kind": "anthropic",
      "model": "claude-opus-5-5",
      "auth": { "type": "api_key", "env": "ANTHROPIC_API_KEY" }
    },
    {
      "id": "claude-cheap",
      "kind": "anthropic",
      "model": "claude-sonnet-5-5",
      "auth": { "type": "api_key", "env": "ANTHROPIC_API_KEY" }
    },
    {
      "id": "local-ollama",
