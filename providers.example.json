{
  "providers": [
    {
      "id": "claude",
      "kind": "anthropic",
      "model": "claude-opus-5-5",
      "auth": { "type": "api_key", "env": "ANTHROPIC_API_KEY" }
    },
    {
      "id": "claude-cheap",
      "kind": "anthropic",
      "model": "claude-sonnet-5-5",
      "auth": { "type": "api_key", "env": "ANTHROPIC_API_KEY" }
    },
    {
      "id": "local-ollama",
      "kind": "openai-compatible",
      "preset": "ollama",
      "model": "REPLACE_WITH_A_MODEL_YOU_HAVE_PULLED",
      "auth": { "type": "none" }
    },
    {
      "id": "groq-llama",
      "kind": "openai-compatible",
      "preset": "groq",
      "model": "llama-3.3-70b-versatile",
      "auth": { "type": "api_key", "env": "GROQ_API_KEY" }
    },
    {
      "id": "openrouter-auto",
      "kind": "openai-compatible",
      "preset": "openrouter",
      "model": "openrouter/auto",
      "auth": { "type": "api_key", "env": "OPENROUTER_API_KEY" }
    }
  ],
  "default": "claude-cheap",
  "agents": {
    "MAIN-12": "claude"
  }
}
