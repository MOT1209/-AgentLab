      "baseUrl": "http://localhost:11434/v1",
      "model": "REPLACE_WITH_A_MODEL_YOU_HAVE_PULLED",
      "auth": { "type": "none" }
    }
  ],
  "default": "claude-cheap",
  "agents": {
    "MAIN-12": "claude"
  }
